# cp .env.example .env && chmod 600 .env 후 값을 채우세요. (.env 는 git 에 올리지 않음)
# 비밀번호에 특수문자($ ` " \ 등)가 있으면 '작은따옴표'로 감싸세요.

DOMAIN=example.com                 # 회사 도메인 (mail. 없이)
ACME_EMAIL=admin@example.com       # 인증서 만료 알림 받을 주소 (외부 메일 권장)

# Amazon SES SMTP 자격 증명 (SES 콘솔 → SMTP 설정 → SMTP 자격 증명 생성)
SES_SMTP_HOST=email-smtp.ap-northeast-2.amazonaws.com
SES_SMTP_USER=CHANGE_ME
SES_SMTP_PASS=CHANGE_ME

# 메일러(listmonk)
LISTMONK_VERSION=6.2.0
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=CHANGE_ME  # 12자 이상
LISTMONK_DB_PASSWORD=auto         # auto = 설치 시 영문·숫자로 자동 생성 (직접 정할 때도 영문·숫자만)

# 백업 (선택)
BACKUP_S3_BUCKET=
BACKUP_KEEP_DAYS=7
