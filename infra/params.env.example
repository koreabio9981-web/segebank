# cp params.env.example params.env 후 값을 채우세요. (params.env 는 git 에 올라가지 않음)
# 값 확인 방법은 docs/AWS_AUTO_DEPLOY.md 의 "파라미터 값 찾기" 참고

STACK_NAME=company-mail
REGION=ap-northeast-2

DomainName=example.com
HostedZoneId=Z0000000000000000000        # Route 53 → 호스팅 영역 → 영역 ID
CreateDnsRecords=true                    # 루트에 MX 나 SPF(TXT) 가 이미 있으면 false
CreateSesIdentities=false                # SES 콘솔에서 이미 도메인 인증했으면 false

VpcId=vpc-00000000                       # 기본 VPC
SubnetId=subnet-00000000                 # 기본 VPC 의 퍼블릭 서브넷
InstanceType=t3.medium
DiskSizeGiB=30
KeyPairName=mail-key                     # EC2 → 키 페어 이름
SshAllowedCidr=203.0.113.10/32           # 내 공인 IP/32  (curl -s https://checkip.amazonaws.com)

RepoUrl=                                 # 공개 저장소면 git 주소, 비공개면 비워 두고 scp 로 복사
RepoBranch=
AlertEmail=admin@example.com             # 장애·비용 알림 받을 주소
MonthlyBudgetUsd=70
